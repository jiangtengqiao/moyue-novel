# ===== 墨阅小说后端环境变量配置 =====
# 复制此文件为 .env 并填入实际值

# 数据库连接 - 本地用 SQLite，生产用 PostgreSQL
# 本地开发(默认):
#   DATABASE_URL=sqlite:///./data/moyue.db
# 生产环境 - Neon (免费 0.5GB，推荐):
#   DATABASE_URL=postgresql://用户名:密码@ep-xxx.region.aws.neon.tech/库名?sslmode=require
# 生产环境 - Supabase (免费 500MB):
#   DATABASE_URL=postgresql://postgres.xxx:密码@db.xxx.supabase.co:5432/postgres
DATABASE_URL=sqlite:///./data/moyue.db

# JWT 密钥 - 生产环境务必改为随机长字符串
SECRET_KEY=mo-yue-novel-secret-key-change-in-production-2024

# APK 外部下载地址前缀(可选)
# 生产环境用 GitHub Releases 托管 APK:
#   APK_DOWNLOAD_BASE=https://github.com/jiangtengqiao/moyue-novel/releases/download/
APK_DOWNLOAD_BASE=

# 调试模式
DEBUG=true
